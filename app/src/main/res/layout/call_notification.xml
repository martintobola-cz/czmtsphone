<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/notification_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true"
    tools:background="#fff">

    <LinearLayout
        android:id="@+id/notification_content_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_thumbnail"
            android:layout_width="@dimen/list_avatar_size"
            android:layout_height="@dimen/list_avatar_size"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/fakeavatar" />

        <LinearLayout
            android:id="@+id/notification_text_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/normal_margin"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_caller_name"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textDirection="firstStrongLtr"
                android:textSize="@dimen/bigger_text_size"
                android:textStyle="bold"
                tools:text="Jan Novák" />

            <TextView
                android:id="@+id/notification_phone_number"
                style="@style/TextAppearance.Compat.Notification.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textDirection="firstStrongLtr"
                android:visibility="gone"
                tools:text="+420 777 123 456"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/notification_meta_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/notification_sim_info"
                    style="@style/TextAppearance.Compat.Notification.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:ellipsize="end"
                    android:alpha="0.7"
                    android:maxLines="1"
                    android:visibility="gone"
                    tools:text="SIM 1" />

                <TextView
                    android:id="@+id/notification_call_status"
                    style="@style/TextAppearance.Compat.Notification.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    tools:text="Volá" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/notification_actions_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/activity_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/notification_page_left"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/previous"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_left_vector"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/notification_call_buttons_holder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/notification_accept_call"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notification_accept"
                android:contentDescription="@string/accept_call"
                android:scaleType="center"
                android:src="@drawable/ic_phone_green_vector" />

            <TextView
                android:id="@+id/notification_buttons_gap"
                android:layout_width="12dp"
                android:layout_height="1dp"
                android:text="" />

            <ImageView
                android:id="@+id/notification_decline_call"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_notification_decline"
                android:contentDescription="@string/decline_call"
                android:scaleType="center"
                android:src="@drawable/ic_phone_down_red_vector" />

        </LinearLayout>

        <ImageView
            android:id="@+id/notification_page_right"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/next"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_right_vector"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>