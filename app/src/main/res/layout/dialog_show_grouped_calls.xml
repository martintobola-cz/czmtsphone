<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/select_grouped_calls_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Záhlaví -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/phoneNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textStyle="bold"
        android:textSize="21sp" />

    <TextView
        android:id="@+id/spamRate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textSize="21sp"
        android:gravity="end" />
</LinearLayout>
    

    <TextView
        android:id="@+id/country"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="17sp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/phoneNumberMezera"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" "
        android:textSize="6sp"
        android:layout_marginBottom="8dp" />

    <!-- Dvousloupcová tabulka -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Sloupec 1: Avatar + ikony -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/photo"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/circle_background" />

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/pinIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" "
                    android:textSize="18sp"
                    android:layout_gravity="center_vertical" />

                <ImageView
                    android:id="@+id/simIconCustom"
                    android:layout_width="23dp"
                    android:layout_height="24dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sim1"
                    android:visibility="gone"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>
        </LinearLayout>

        <!-- Sloupec 2: Textová část -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/specificType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="17sp"
                android:textColor="?attr/colorAccent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:ellipsize="end"
                android:layout_marginTop="4dp" />

<View
    android:id="@+id/spacerBeforeSim1"
    android:layout_width="match_parent"
    android:layout_height="13dp"
    android:visibility="gone"/>

<LinearLayout
    android:id="@+id/sim1InfoLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="4dp">

    <ImageView
        android:id="@+id/sim1Icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sim1"
        android:layout_marginEnd="0dp" 
        android:translationX="-1mm" 
        android:visibility="gone"/>

    <TextView
        android:id="@+id/sim1Info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"/>
</LinearLayout>

<View
    android:id="@+id/spacerAfterSim1"
    android:layout_width="match_parent"
    android:layout_height="15dp"
    android:visibility="gone"/>

<LinearLayout
    android:id="@+id/sim2InfoLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_marginTop="4dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/sim2Icon"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_sim2"
        android:layout_marginEnd="0dp" 
        android:translationX="-1mm" />

    <TextView
        android:id="@+id/sim2Info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"/>
</LinearLayout>


        </LinearLayout>
    </LinearLayout>


    <!-- Seznam volání -->
    <cz.mts.base.views.MyRecyclerView
        android:id="@+id/select_grouped_calls_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layoutManager="cz.mts.base.views.MyLinearLayoutManager"
        android:layout_marginTop="8dp"/>
</LinearLayout>
