<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recorded_files_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <cz.mts.base.views.MyAppBarLayout
        android:id="@+id/recorded_files_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/recorded_files_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/color_primary"
            app:title="@string/call_recording_files"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </cz.mts.base.views.MyAppBarLayout>

    <cz.mts.base.views.MyRecyclerView
        android:id="@+id/recorded_files_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        app:layoutManager="cz.mts.base.views.MyLinearLayoutManager"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_recorded_file" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/recorded_files_empty_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:maxWidth="180dp"
            android:maxHeight="180dp"
            android:scaleType="fitCenter"
            android:src="@drawable/empty_ogg_folder"
            android:visibility="gone" />

        <cz.mts.base.views.MyTextView
            android:id="@+id/recorded_files_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/activity_margin"
            android:text="@string/call_recording_files_empty"
            android:visibility="gone" />

    </LinearLayout>

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_indicator_files"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:visibility="gone"
        app:trackCornerRadius="@dimen/small_margin" />

    <!-- Mini ovladač: pause/play, aktuální čas, posuvník, celková délka. Viditelný jen když je něco načtené. -->
    <LinearLayout
        android:id="@+id/recorded_files_player_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/recorded_files_player_play_pause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_player_play" />

        <cz.mts.base.views.MyTextView
            android:id="@+id/recorded_files_player_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="36dp"
            android:text="0:00"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/recorded_files_player_seek"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1" />

        <cz.mts.base.views.MyTextView
            android:id="@+id/recorded_files_player_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="36dp"
            android:gravity="end"
            android:text="0:00"
            android:textSize="12sp" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>