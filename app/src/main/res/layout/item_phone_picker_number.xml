<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:paddingVertical="@dimen/tiny_margin">

    <CheckBox
        android:id="@+id/checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tiny_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <cz.mts.base.views.MyTextView
        android:id="@+id/phoneNumber"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tiny_margin"
        android:textSize="@dimen/normal_text_size"
        android:textDirection="ltr"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintStart_toEndOf="@id/checkbox"
        app:layout_constraintEnd_toStartOf="@id/phoneSeparator"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <cz.mts.base.views.MyTextView
        android:id="@+id/phoneSeparator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/small_margin"
        android:alpha="0.6"
        android:text="–"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintStart_toEndOf="@id/phoneNumber"
        app:layout_constraintEnd_toStartOf="@id/phoneType"
        app:layout_constraintTop_toTopOf="@id/phoneNumber"
        app:layout_constraintBottom_toBottomOf="@id/phoneNumber" />

    <cz.mts.base.views.MyTextView
        android:id="@+id/phoneType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/activity_margin"
        android:alpha="0.6"
        android:textSize="@dimen/normal_text_size"
        app:layout_constraintStart_toEndOf="@id/phoneSeparator"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/phoneNumber"
        app:layout_constraintBottom_toBottomOf="@id/phoneNumber" />

</androidx.constraintlayout.widget.ConstraintLayout>
