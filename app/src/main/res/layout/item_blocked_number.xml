<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_blocked_number_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/normal_margin"
    android:paddingTop="@dimen/small_margin"
    android:paddingEnd="@dimen/medium_margin"
    android:paddingBottom="@dimen/small_margin">

    <!-- pozadí (ripple / selected stav) se nastavuje za běhu přes root.setupViewBackground(activity)
         + itemBlockedNumberHolder.isSelected, stejně jako u item_recent_call.xml -->

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/item_blocked_number_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Jan Novák" />

        <TextView
            android:id="@+id/item_blocked_number_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:visibility="gone"
            tools:text="+420 777 123 456"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
