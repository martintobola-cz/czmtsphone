<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/contact_history_row_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/activity_margin"
    android:paddingEnd="@dimen/activity_margin"
    android:paddingTop="@dimen/medium_margin_recent"
    android:paddingBottom="@dimen/medium_margin_recent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">


        <FrameLayout
            android:id="@+id/history_row_sim_holder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/history_row_sim_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="@dimen/tiny_margin"
                android:layout_marginStart="-4dp"
                android:src="@drawable/ic_sim_vector" />

            <TextView
                android:id="@+id/history_row_sim_id"
               android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:textColor="@color/md_grey_black"
        android:textSize="@dimen/small_text_size"
                tools:text="1" />

        </FrameLayout>

        <ImageView
            android:id="@+id/history_row_type_icon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/tiny_margin"
            android:padding="@dimen/tiny_margin"
            android:src="@drawable/ic_call_missed_vector"
            tools:tint="@color/color_missed_call" />

        <TextView
            android:id="@+id/history_row_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/tiny_margin"
            android:maxLines="1"
            android:textSize="@dimen/normal_text_size"
            tools:text="4. 7. 2026" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/history_row_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:gravity="end"
            android:textSize="@dimen/normal_text_size"
            tools:text="42m 17s" />

    </LinearLayout>

    <!-- Řádek 2: čas • telefonní číslo • typ čísla -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tiny_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/history_row_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:fontFeatureSettings="tnum"
            android:textSize="@dimen/normal_text_size"
            tools:text="16:37" />

        <TextView
            android:id="@+id/history_row_time_number_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:textSize="@dimen/normal_text_size"
            tools:text=" ⁝ " />

        <TextView
    android:id="@+id/history_row_number"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/small_margin"
    android:ellipsize="end"
    android:maxLines="1"
    android:textSize="@dimen/normal_text_size"
    tools:text="+420 731 731 731" />

        <TextView
            android:id="@+id/history_row_number_type_separator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:textSize="@dimen/small_text_size"
            tools:text="•" />

        <TextView
            android:id="@+id/history_row_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/small_margin"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/small_text_size"
            tools:text="Mobil" />

    </LinearLayout>

</LinearLayout>